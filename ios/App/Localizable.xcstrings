    "We sent a link to confirm your account. Open it, then sign in here.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أرسلنا رابطًا لتأكيد حسابك. افتحه ثم سجّل الدخول هنا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আমরা আপনার অ্যাকাউন্ট নিশ্চিত করার জন্য একটি লিংক পাঠিয়েছি। সেটি খুলুন, তারপর এখানে সাইন ইন করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir haben dir einen Link zur Bestätigung deines Kontos geschickt. Öffne ihn und melde dich dann hier an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We sent a link to confirm your account. Open it, then sign in here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Te enviamos un enlace para confirmar tu cuenta. Ábrelo y luego inicia sesión aquí."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پیوندی برای تأیید حسابتان فرستادیم. آن را باز کنید و سپس اینجا وارد شوید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous vous avons envoyé un lien pour confirmer votre compte. Ouvrez-le, puis connectez-vous ici."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שלחנו קישור לאישור החשבון שלכם. פתחו אותו ואז היכנסו כאן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हमने आपका खाता पक्का करने के लिए एक लिंक भेजा है। उसे खोलें, फिर यहाँ साइन इन करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kami mengirim tautan untuk mengonfirmasi akun Anda. Buka tautan itu, lalu masuk di sini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ti abbiamo inviato un link per confermare il tuo account. Aprilo, poi accedi qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウント確認用のリンクを送信しました。開いてから、ここでサインインしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정 확인용 링크를 보냈습니다. 링크를 연 다음 여기에서 로그인하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kami telah menghantar pautan untuk mengesahkan akaun anda. Buka pautan itu, kemudian log masuk di sini."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "We hebben een link gestuurd om je account te bevestigen. Open die en log hier in."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wysłaliśmy link potwierdzający Twoje konto. Otwórz go, a potem zaloguj się tutaj."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Enviamos um link para confirmar sua conta. Abra-o e depois entre aqui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мы отправили ссылку для подтверждения аккаунта. Откройте её, затем войдите здесь."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi har skickat en länk för att bekräfta ditt konto. Öppna den och logga sedan in här."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Tumekutumia kiungo cha kuthibitisha akaunti yako. Kifungue, kisha ingia hapa."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เราส่งลิงก์ยืนยันบัญชีให้แล้ว เปิดลิงก์นั้น แล้วลงชื่อเข้าใช้ที่นี่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesabını onaylaman için bir bağlantı gönderdik. Aç, sonra burada giriş yap."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ми надіслали посилання для підтвердження облікового запису. Відкрийте його, а потім увійдіть тут."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہم نے آپ کے اکاؤنٹ کی تصدیق کے لیے ایک لنک بھیجا ہے۔ اسے کھولیں، پھر یہاں سائن اِن کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chúng tôi đã gửi một liên kết để xác nhận tài khoản của bạn. Hãy mở nó, rồi đăng nhập tại đây."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我们发送了一个确认账户的链接。打开它，然后在这里登录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "我們已傳送確認帳號的連結。開啟連結後，請在這裡登入。"
          }
        }
      }
    },
