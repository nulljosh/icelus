    "Could not reach the server. Check your connection.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر الوصول إلى الخادم. تحقق من اتصالك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সার্ভারে পৌঁছানো যায়নি। আপনার সংযোগ পরীক্ষা করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Server nicht erreichbar. Prüfe deine Verbindung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not reach the server. Check your connection."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo conectar con el servidor. Revisa tu conexión."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اتصال به سرور برقرار نشد. اتصالتان را بررسی کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de joindre le serveur. Vérifiez votre connexion."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן להתחבר לשרת. בדקו את החיבור."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सर्वर तक नहीं पहुँच सके। अपना कनेक्शन जाँचें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak dapat terhubung ke server. Periksa koneksi Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile raggiungere il server. Controlla la connessione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーに接続できませんでした。接続を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버에 연결할 수 없습니다. 연결 상태를 확인하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak dapat menghubungi pelayan. Semak sambungan anda."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De server is niet bereikbaar. Controleer je verbinding."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można połączyć się z serwerem. Sprawdź połączenie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível acessar o servidor. Verifique sua conexão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось связаться с сервером. Проверьте подключение."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det gick inte att nå servern. Kontrollera din anslutning."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Imeshindwa kufikia seva. Angalia muunganisho wako."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เชื่อมต่อเซิร์ฟเวอร์ไม่ได้ ตรวจสอบการเชื่อมต่อของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunucuya ulaşılamadı. Bağlantını kontrol et."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося зв'язатися із сервером. Перевірте з'єднання."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "سرور تک رسائی نہیں ہو سکی۔ اپنا کنکشن چیک کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không kết nối được với máy chủ. Hãy kiểm tra kết nối của bạn."
          }
        },
        "zh-Hans": {
