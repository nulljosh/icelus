    "If that address has an account, a reset link is on its way.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إذا كان لهذا العنوان حساب، فرابط إعادة التعيين في طريقه إليك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ওই ঠিকানায় অ্যাকাউন্ট থাকলে একটি রিসেট লিংক আপনার কাছে যাচ্ছে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Falls es zu dieser Adresse ein Konto gibt, ist ein Link zum Zurücksetzen unterwegs."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If that address has an account, a reset link is on its way."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si esa dirección tiene una cuenta, un enlace de restablecimiento está en camino."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اگر این نشانی حسابی داشته باشد، پیوند بازنشانی در راه است."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si cette adresse est associée à un compte, un lien de réinitialisation est en route."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אם לכתובת הזו יש חשבון, קישור לאיפוס בדרך אליה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अगर उस पते पर खाता है, तो रीसेट लिंक भेजा जा रहा है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika alamat itu punya akun, tautan atur ulang sedang dalam perjalanan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se quell'indirizzo ha un account, un link di reimpostazione sta arrivando."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そのアドレスのアカウントがある場合は、リセットリンクを送信しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "해당 주소로 가입된 계정이 있다면 재설정 링크가 전송됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika alamat itu mempunyai akaun, pautan tetapan semula sedang dalam perjalanan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als dat adres een account heeft, is er een herstellink onderweg."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeśli ten adres ma konto, link do resetu hasła jest już w drodze."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Se esse endereço tiver uma conta, um link de redefinição está a caminho."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если у этого адреса есть аккаунт, ссылка для сброса уже в пути."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Om adressen har ett konto är en återställningslänk på väg."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikiwa anwani hiyo ina akaunti, kiungo cha kuweka upya kiko njiani."
