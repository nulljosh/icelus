    "Swaps box-drawing characters for + - | so a wireframe reads anywhere, even in email.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستبدل رموز رسم الإطارات بـ + - | ليُقرأ الإطار السلكي في أي مكان، حتى في البريد الإلكتروني."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বক্স আঁকার অক্ষরগুলোকে + - | দিয়ে বদলে দেয়, যাতে ওয়্যারফ্রেম যেকোনো জায়গায় পড়া যায়, ইমেলেও।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ersetzt Rahmenzeichen durch + - |, damit ein Wireframe überall lesbar ist, sogar in E-Mails."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Swaps box-drawing characters for + - | so a wireframe reads anywhere, even in email."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia los caracteres de dibujo de cajas por + - | para que un wireframe se lea en cualquier lugar, incluso en un correo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "نویسه‌های رسم کادر را با + - | عوض می‌کند تا وایرفریم در هر جایی، حتی در ایمیل، خوانا باشد."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remplace les caractères de dessin de cadres par + - | pour qu'un wireframe s'affiche partout, même dans un e-mail."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מחליף תווי שרטוט מסגרות ב-+ - | כדי שמתווה חוטי ייקרא בכל מקום, גם במייל."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बॉक्स बनाने वाले अक्षरों को + - | से बदलता है, ताकि वायरफ़्रेम कहीं भी पढ़ा जा सके, ईमेल में भी।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengganti karakter gambar kotak dengan + - | agar wireframe bisa dibaca di mana saja, bahkan di email."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sostituisce i caratteri di disegno dei riquadri con + - | così un wireframe si legge ovunque, anche nelle email."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "罫線の文字を + - | に置き換えるので、ワイヤーフレームはメールの中でも読めます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "상자 그리기 문자를 + - |로 바꿔서 와이어프레임을 어디서든, 이메일에서도 읽을 수 있게 합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menukar aksara lukisan kotak kepada + - | supaya wireframe boleh dibaca di mana-mana, malah dalam e-mel."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vervangt tekentekens voor kaders door + - | zodat een wireframe overal leesbaar is, zelfs in e-mail."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zamienia znaki rysowania ramek na + - |, więc wireframe czytelnie wyświetli się wszędzie, nawet w e-mailu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Troca os caracteres de desenho de caixas por + - | para que um wireframe seja legível em qualquer lugar, até em e-mails."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заменяет символы рамок на + - |, чтобы вайрфрейм читался где угодно, даже в письме."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Byter ut rittecken för rutor mot + - | så att en wireframe går att läsa överallt, även i e-post."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Hubadilisha herufi za kuchora fremu kuwa + - | ili fremu isomeke popote, hata kwenye barua pepe."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปลี่ยนอักขระวาดกรอบเป็น + - | เพื่อให้ไวร์เฟรมอ่านได้ทุกที่ แม้แต่ในอีเมล"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kutu çizim karakterlerini + - | ile değiştirir, böylece wireframe e-postada bile her yerde okunabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Замінює символи рамок на + - |, щоб вайрфрейм читався скрізь, навіть в електронному листі."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "باکس بنانے والے حروف کو + - | سے بدل دیتا ہے تاکہ وائر فریم ہر جگہ پڑھا جا سکے، ای میل میں بھی۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đổi ký tự vẽ khung thành + - | để khung dây đọc được ở mọi nơi, kể cả trong email."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将框线字符替换为 + - |，使线框在任何地方都能阅读，包括电子邮件中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將框線字元替換為 + - |，讓線框在任何地方都能閱讀，包括電子郵件中。"
          }
        }
      }
    },
