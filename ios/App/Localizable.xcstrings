    "Confirm your email first. The link is in your inbox.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أكّد بريدك الإلكتروني أولًا. الرابط في صندوق الوارد."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আগে আপনার ইমেইল নিশ্চিত করুন। লিংকটি ইনবক্সে আছে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bestätige zuerst deine E-Mail. Den Link findest du im Postfach."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm your email first. The link is in your inbox."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirma primero tu correo. El enlace está en tu bandeja de entrada."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ابتدا ایمیلتان را تأیید کنید. پیوند در صندوق ورودی است."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirmez d'abord votre e-mail. Le lien se trouve dans votre boîte de réception."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קודם אשרו את האימייל. הקישור נמצא בתיבת הדואר הנכנס."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पहले अपना ईमेल पक्का करें। लिंक आपके इनबॉक्स में है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Konfirmasi email Anda dulu. Tautannya ada di kotak masuk."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Conferma prima la tua e-mail. Il link è nella tua posta in arrivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "先にメールアドレスを確認してください。リンクは受信トレイにあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼저 이메일을 인증하세요. 링크는 받은편지함에 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sahkan e-mel anda dahulu. Pautannya ada dalam peti masuk anda."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bevestig eerst je e-mail. De link staat in je inbox."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najpierw potwierdź swój e-mail. Link jest w skrzynce odbiorczej."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirme seu e-mail primeiro. O link está na sua caixa de entrada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сначала подтвердите почту. Ссылка во входящих."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekräfta din e-post först. Länken finns i din inkorg."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Thibitisha barua pepe yako kwanza. Kiungo kiko kwenye kikasha chako."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยืนยันอีเมลของคุณก่อน ลิงก์อยู่ในกล่องจดหมาย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önce e-postanı onayla. Bağlantı gelen kutunda."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Спершу підтвердьте пошту. Посилання у вхідних."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "پہلے اپنی ای میل کی تصدیق کریں۔ لنک آپ کے ان باکس میں ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy xác nhận email trước. Liên kết nằm trong hộp thư đến."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先确认你的邮箱。链接在你的收件箱里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請先確認你的電子郵件。連結在你的收件匣裡。"
          }
