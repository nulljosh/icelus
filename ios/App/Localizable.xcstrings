    "An account keeps your name with your work. Everything works without one.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الحساب يحفظ اسمك مع أعمالك. كل شيء يعمل بدونه."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অ্যাকাউন্ট আপনার নামটি আপনার কাজের সঙ্গে রাখে। অ্যাকাউন্ট ছাড়াও সবকিছু কাজ করে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit einem Konto bleibt dein Name bei deiner Arbeit. Alles funktioniert auch ohne."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An account keeps your name with your work. Everything works without one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una cuenta mantiene tu nombre junto a tu trabajo. Todo funciona sin ella."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "حساب، نام شما را کنار کارتان نگه می‌دارد. همه‌چیز بدون آن هم کار می‌کند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un compte garde votre nom avec votre travail. Tout fonctionne sans compte."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "חשבון שומר את השם שלכם יחד עם העבודה שלכם. הכול עובד גם בלי חשבון."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "खाता आपका नाम आपके काम के साथ रखता है। खाते के बिना भी सब कुछ चलता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Akun menyimpan nama Anda bersama karya Anda. Semuanya tetap berfungsi tanpa akun."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un account tiene il tuo nome insieme al tuo lavoro. Tutto funziona anche senza."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントを作ると、あなたの名前が作品と一緒に残ります。アカウントなしでもすべて使えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정을 만들면 내 이름이 작업과 함께 보관됩니다. 계정 없이도 모든 기능을 쓸 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Akaun menyimpan nama anda bersama hasil kerja anda. Semuanya berfungsi tanpa akaun."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Met een account blijft je naam bij je werk. Alles werkt ook zonder."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Konto trzyma Twoje imię razem z Twoją pracą. Wszystko działa też bez niego."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma conta mantém seu nome junto com seu trabalho. Tudo funciona sem ela."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Аккаунт хранит ваше имя вместе с вашей работой. Без него всё тоже работает."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett konto håller ditt namn samlat med ditt arbete. Allt fungerar även utan."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Akaunti huweka jina lako pamoja na kazi yako. Kila kitu hufanya kazi bila akaunti."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บัญชีช่วยเก็บชื่อของคุณไว้กับผลงาน ทุกอย่างใช้งานได้แม้ไม่มีบัญชี"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesap, adını çalışmanla birlikte tutar. Hesap olmadan da her şey çalışır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Обліковий запис зберігає ваше ім'я разом із вашою роботою. Без нього все теж працює."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اکاؤنٹ آپ کا نام آپ کے کام کے ساتھ رکھتا ہے۔ اکاؤنٹ کے بغیر بھی سب کچھ چلتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tài khoản giữ tên của bạn cùng với tác phẩm. Mọi thứ vẫn dùng được khi không có tài khoản."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "账户会把你的名字和作品放在一起。没有账户也能使用全部功能。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "帳號會把你的名字和作品放在一起。沒有帳號也能使用所有功能。"
          }
        }
      }
    },
