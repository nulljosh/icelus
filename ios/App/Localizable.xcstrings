    "Done. Your screen is plain text now. Paste it into a chat, a doc or a pull request.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم. أصبحت شاشتك نصًا عاديًا. الصقها في محادثة أو مستند أو pull request."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "হয়ে গেছে। আপনার স্ক্রিন এখন সাদা টেক্সট। এটি চ্যাট, ডকুমেন্ট বা pull request-এ পেস্ট করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fertig. Dein Bildschirm ist jetzt einfacher Text. Füge ihn in einen Chat, ein Dokument oder einen Pull Request ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Done. Your screen is plain text now. Paste it into a chat, a doc or a pull request."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Listo. Tu pantalla ya es texto plano. Pégala en un chat, un documento o una pull request."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تمام شد. صفحهٔ شما حالا متن ساده است. آن را در یک چت، سند یا pull request بچسبانید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminé. Votre écran est maintenant du texte brut. Collez-le dans une discussion, un document ou une pull request."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "סיימתם. המסך שלכם הוא עכשיו טקסט פשוט. הדביקו אותו בצ’אט, במסמך או ב־pull request."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हो गया। आपकी स्क्रीन अब सादा टेक्स्ट है। इसे चैट, दस्तावेज़ या pull request में पेस्ट करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Selesai. Layar Anda sekarang berupa teks biasa. Tempel ke obrolan, dokumen, atau pull request."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fatto. La tua schermata ora è testo semplice. Incollala in una chat, in un documento o in una pull request."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "完了です。画面がプレーンテキストになりました。チャットやドキュメント、プルリクエストに貼り付けてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "완료되었습니다. 이제 화면이 일반 텍스트가 되었습니다. 채팅, 문서 또는 pull request에 붙여넣으세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Selesai. Skrin anda kini ialah teks biasa. Tampalkan dalam sembang, dokumen atau pull request."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klaar. Je scherm is nu platte tekst. Plak het in een chat, een document of een pull request."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gotowe. Twój ekran jest teraz zwykłym tekstem. Wklej go do czatu, dokumentu lub pull requesta."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pronto. Sua tela agora é texto simples. Cole em um chat, um documento ou um pull request."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Готово. Теперь ваш экран стал простым текстом. Вставьте его в чат, документ или pull request."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Klart. Din skärm är nu vanlig text. Klistra in den i en chatt, ett dokument eller en pull request."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Imekamilika. Skrini yako sasa ni maandishi matupu. Ibandike kwenye gumzo, hati au pull request."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เสร็จแล้ว หน้าจอของคุณเป็นข้อความธรรมดาแล้ว วางลงในแชต เอกสาร หรือ pull request ได้เลย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitti. Ekranın artık düz metin. Bir sohbete, belgeye veya pull request’e yapıştır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Готово. Тепер ваш екран став простим текстом. Вставте його в чат, документ або pull request."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہو گیا۔ آپ کی اسکرین اب سادہ متن ہے۔ اسے چیٹ، دستاویز یا pull request میں پیسٹ کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xong. Màn hình của bạn giờ là văn bản thuần. Hãy dán nó vào cuộc trò chuyện, tài liệu hoặc pull request."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完成。你的屏幕现在是纯文本了。把它粘贴到聊天、文档或 pull request 中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "完成。你的畫面現在是純文字了。把它貼到聊天、文件或 pull request 中。"
          }
        }
      }
    },
