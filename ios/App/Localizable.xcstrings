    "This deletes your account for good. Your sketches stay on this device.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيؤدي هذا إلى حذف حسابك نهائيًا. تبقى رسوماتك على هذا الجهاز."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এটি আপনার অ্যাকাউন্ট চিরতরে মুছে দেবে। আপনার স্কেচগুলো এই ডিভাইসেই থাকবে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Damit wird dein Konto endgültig gelöscht. Deine Skizzen bleiben auf diesem Gerät."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This deletes your account for good. Your sketches stay on this device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto elimina tu cuenta para siempre. Tus bocetos se quedan en este dispositivo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این کار حسابتان را برای همیشه حذف می‌کند. طرح‌هایتان روی این دستگاه می‌مانند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela supprime définitivement votre compte. Vos croquis restent sur cet appareil."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הפעולה מוחקת את החשבון שלכם לצמיתות. הסקיצות שלכם נשארות במכשיר הזה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इससे आपका खाता हमेशा के लिए हट जाएगा। आपके स्केच इसी डिवाइस पर रहेंगे।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini menghapus akun Anda secara permanen. Sketsa Anda tetap ada di perangkat ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo elimina definitivamente il tuo account. I tuoi schizzi restano su questo dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントは完全に削除されます。スケッチはこのデバイスに残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정이 완전히 삭제됩니다. 스케치는 이 기기에 그대로 남습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini memadam akaun anda selama-lamanya. Lakaran anda kekal pada peranti ini."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit verwijdert je account definitief. Je schetsen blijven op dit apparaat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To na zawsze usunie Twoje konto. Twoje szkice zostaną na tym urządzeniu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso exclui sua conta para sempre. Seus esboços ficam neste dispositivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это навсегда удалит ваш аккаунт. Ваши наброски останутся на этом устройстве."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det här tar bort ditt konto för alltid. Dina skisser finns kvar på den här enheten."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Hii inafuta akaunti yako kabisa. Michoro yako inabaki kwenye kifaa hiki."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การลบนี้จะลบบัญชีของคุณถาวร ภาพสเกตช์ของคุณยังอยู่ในอุปกรณ์เครื่องนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu, hesabını kalıcı olarak siler. Taslakların bu cihazda kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це назавжди видалить ваш обліковий запис. Ваші ескізи залишаться на цьому пристрої."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس سے آپ کا اکاؤنٹ ہمیشہ کے لیے حذف ہو جائے گا۔ آپ کے خاکے اسی ڈیوائس پر رہیں گے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thao tác này xóa vĩnh viễn tài khoản của bạn. Các bản phác thảo vẫn ở trên thiết bị này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这会永久删除你的账户。你的草图会保留在此设备上。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這會永久刪除你的帳號。你的草圖會留在這部裝置上。"
          }
        }
      }
    },
