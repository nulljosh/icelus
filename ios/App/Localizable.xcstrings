    "Passwords need at least 8 characters.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجب أن تتكون كلمة المرور من 8 أحرف على الأقل."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পাসওয়ার্ডে কমপক্ষে ৮টি অক্ষর লাগবে।"
