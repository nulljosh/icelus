    "Put a screen together from parts, then copy it as plain text. Want a quick walk through?": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ركّب شاشة من أجزاء ثم انسخها كنص عادي. هل تريد جولة سريعة؟"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অংশগুলো জুড়ে একটি স্ক্রিন বানান, তারপর সাদা টেক্সট হিসেবে কপি করুন। একটু ঘুরে দেখতে চান?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Setze einen Bildschirm aus Teilen zusammen und kopiere ihn als einfachen Text. Möchtest du eine kurze Einführung?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Put a screen together from parts, then copy it as plain text. Want a quick walk through?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Monta una pantalla con piezas y cópiala como texto plano. ¿Quieres un recorrido rápido?"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "صفحه‌ای را از چند قطعه کنار هم بچینید و آن را به‌صورت متن ساده کپی کنید. یک تور کوتاه می‌خواهید؟"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Composez un écran à partir de pièces, puis copiez-le en texte brut. Une petite visite guidée ?"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הרכיבו מסך מחלקים והעתיקו אותו כטקסט פשוט. רוצים סיור קצר?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हिस्सों को जोड़कर एक स्क्रीन बनाएँ, फिर उसे सादे टेक्स्ट के रूप में कॉपी करें। क्या एक छोटा टूर चाहेंगे?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Susun layar dari bagian-bagian, lalu salin sebagai teks biasa. Mau tur singkat?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Componi una schermata con i pezzi, poi copiala come testo semplice. Vuoi una breve guida?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パーツを組み合わせて画面を作り、プレーンテキストとしてコピーします。かんたんな案内を見ますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "부품을 조합해 화면을 만들고 일반 텍스트로 복사하세요. 간단히 안내해 드릴까요?"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Susun skrin daripada bahagian, kemudian salin sebagai teks biasa. Mahu lawatan ringkas?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zet een scherm in elkaar uit onderdelen en kopieer het als platte tekst. Wil je een korte rondleiding?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Złóż ekran z elementów, a potem skopiuj go jako zwykły tekst. Chcesz szybkie wprowadzenie?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Monte uma tela com peças e depois copie como texto simples. Quer um tour rápido?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Соберите экран из деталей и скопируйте его простым текстом. Хотите быстрый обзор?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sätt ihop en skärm av delar och kopiera den sedan som vanlig text. Vill du ha en snabb genomgång?"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Unda skrini kwa vipande, kisha inakili kama maandishi matupu. Ungependa ziara fupi?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ประกอบหน้าจอจากชิ้นส่วน แล้วคัดลอกเป็นข้อความธรรมดา อยากให้พาชมสั้น ๆ ไหม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parçalardan bir ekran oluştur, sonra düz metin olarak kopyala. Kısa bir tur ister misin?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Складіть екран із частин і скопіюйте його простим текстом. Хочете короткий огляд?"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "حصوں کو جوڑ کر ایک اسکرین بنائیں، پھر اسے سادہ متن کے طور پر کاپی کریں۔ کیا مختصر جائزہ دیکھنا چاہیں گے؟"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghép một màn hình từ các thành phần, rồi sao chép dưới dạng văn bản thuần. Bạn muốn xem hướng dẫn nhanh không?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用部件拼出一个屏幕，再复制为纯文本。想快速看一遍吗？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用元件拼出一個畫面，再複製成純文字。想快速看一遍嗎？"
          }
        }
      }
    },
