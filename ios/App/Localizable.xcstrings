    "Icelus reads the page and writes it as typed lines. Change them if you like, then draw.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يقرأ Icelus الصفحة ويكتبها كسطور مكتوبة. غيّرها إن شئت، ثم ارسم."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Icelus পেজটি পড়ে টাইপ করা লাইনে লিখে দেয়। চাইলে বদলান, তারপর আঁকুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Icelus liest die Seite und schreibt sie als getippte Zeilen. Ändere sie nach Belieben, dann zeichne."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Icelus reads the page and writes it as typed lines. Change them if you like, then draw."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Icelus lee la página y la escribe como líneas de texto. Cámbialas si quieres y luego dibuja."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "Icelus صفحه را می‌خواند و آن را به‌صورت خطوط تایپی می‌نویسد. اگر خواستید تغییرشان دهید، سپس بکشید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Icelus lit la page et l’écrit en lignes tapées. Modifiez-les si vous voulez, puis dessinez."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Icelus קורא את העמוד וכותב אותו כשורות מוקלדות. שנו אותן אם תרצו, ואז ציירו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Icelus पेज पढ़कर उसे टाइप की गई पंक्तियों में लिखता है। चाहें तो बदलें, फिर ड्रॉ करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Icelus membaca halaman dan menuliskannya sebagai baris ketikan. Ubah jika mau, lalu gambar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Icelus legge la pagina e la scrive come righe digitate. Modificale se vuoi, poi disegna."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Icelus がページを読み、入力行として書き出します。必要なら直してから描きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Icelus가 페이지를 읽어 입력 줄로 적어 줍니다. 원하면 고친 뒤 그리세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Icelus membaca halaman dan menulisnya sebagai baris taipan. Ubah jika mahu, kemudian lukis."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Icelus leest de pagina en schrijft hem als getypte regels. Pas ze aan als je wilt en teken dan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Icelus czyta stronę i zapisuje ją jako wpisane linie. Zmień je, jeśli chcesz, i narysuj."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Icelus lê a página e a escreve como linhas digitadas. Mude-as se quiser e depois desenhe."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Icelus читает страницу и записывает её набранными строками. Измените их, если нужно, и нарисуйте."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Icelus läser sidan och skriver den som inskrivna rader. Ändra dem om du vill och rita sedan."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Icelus inasoma ukurasa na kuuandika kama mistari ya maandishi. Ibadilishe ukipenda, kisha chora."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Icelus อ่านหน้าและเขียนออกมาเป็นบรรทัดพิมพ์ แก้ได้ตามใจ แล้วค่อยวาด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Icelus sayfayı okur ve yazılı satırlar olarak yazar. İstersen değiştir, sonra çiz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Icelus читає сторінку й записує її набраними рядками. Змініть їх за бажання, а тоді намалюйте."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Icelus صفحہ پڑھ کر اسے ٹائپ کی ہوئی لائنوں میں لکھتا ہے۔ چاہیں تو بدلیں، پھر ڈرا کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Icelus đọc trang và viết lại thành các dòng gõ. Sửa nếu muốn, rồi vẽ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Icelus 读取网页并写成文字行。可以先改一改，再绘制。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Icelus 讀取網頁並寫成文字行。可以先改一改，再繪製。"
          }
        }
      }
    },
