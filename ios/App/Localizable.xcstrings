    "Now drag the button to a new spot.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الآن اسحب الزر إلى مكان جديد."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এবার বোতামটি নতুন জায়গায় টেনে আনুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehe die Schaltfläche jetzt an eine neue Stelle."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Now drag the button to a new spot."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahora arrastra el botón a otro sitio."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "حالا دکمه را به جای تازه‌ای بکشید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites maintenant glisser le bouton vers un nouvel endroit."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עכשיו גררו את הכפתור למקום חדש."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अब बटन को नई जगह पर खींचें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sekarang seret tombol ke tempat baru."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ora trascina il pulsante in un nuovo punto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次に、ボタンを新しい場所にドラッグします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이제 버튼을 새 위치로 드래그하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sekarang seret butang ke tempat baharu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleep de knop nu naar een nieuwe plek."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Teraz przeciągnij przycisk w nowe miejsce."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Agora arraste o botão para outro lugar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Теперь перетащите кнопку на новое место."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dra nu knappen till en ny plats."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Sasa buruta kitufe hadi mahali papya."
          }
