    "That email and password do not match.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "البريد الإلكتروني وكلمة المرور غير متطابقين."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ইমেইল ও পাসওয়ার্ড মিলছে না।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "E-Mail und Passwort passen nicht zusammen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That email and password do not match."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ese correo y esa contraseña no coinciden."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این ایمیل و گذرواژه با هم نمی‌خوانند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet e-mail et ce mot de passe ne correspondent pas."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "האימייל והסיסמה לא תואמים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह ईमेल और पासवर्ड मेल नहीं खाते।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Email dan kata sandi itu tidak cocok."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa e-mail e questa password non corrispondono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メールアドレスとパスワードが一致しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이메일과 비밀번호가 일치하지 않습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "E-mel dan kata laluan itu tidak sepadan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit e-mailadres en wachtwoord komen niet overeen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten e-mail i hasło do siebie nie pasują."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Esse e-mail e essa senha não correspondem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта почта и пароль не совпадают."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den e-postadressen och det lösenordet stämmer inte överens."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Barua pepe na nenosiri hizo hazilingani."
          }
        },
