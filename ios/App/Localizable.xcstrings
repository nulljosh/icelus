    "Choose Edit text, type new words like Sign up, then Save.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر «تعديل النص»، واكتب كلمات جديدة مثل «اشترك»، ثم اضغط على «حفظ»."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "টেক্সট সম্পাদনা করুন বেছে নিন, সাইন আপ-এর মতো নতুন শব্দ লিখুন, তারপর সংরক্ষণ বেছে নিন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle Text bearbeiten, tippe neue Wörter wie Registrieren und dann Sichern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose Edit text, type new words like Sign up, then Save."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige Editar texto, escribe palabras nuevas como Registrarse y pulsa Guardar."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "«ویرایش متن» را انتخاب کنید، کلمه‌های تازه‌ای مثل «ثبت‌نام» بنویسید و بعد «ذخیره» را بزنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez Modifier le texte, saisissez de nouveaux mots comme S’inscrire, puis Enregistrer."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בחרו עריכת טקסט, הקלידו מילים חדשות כמו הרשמה, ואז שמירה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "टेक्स्ट संपादित करें चुनें, साइन अप जैसे नए शब्द लिखें, फिर सहेजें चुनें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih Edit teks, ketik kata baru seperti Daftar, lalu pilih Simpan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli Modifica testo, scrivi parole nuove come Iscriviti, poi Salva."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「テキストを編集」を選び、「新規登録」のような新しい言葉を入力して、「保存」を選びます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "텍스트 편집을 선택하고, 가입하기 같은 새 단어를 입력한 다음 저장을 선택하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih Edit teks, taip perkataan baharu seperti Daftar, kemudian pilih Simpan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies Tekst bewerken, typ nieuwe woorden zoals Aanmelden en kies dan Opslaan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz Edytuj tekst, wpisz nowe słowa, na przykład Zarejestruj się, i wybierz Zapisz."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha Editar texto, digite palavras novas como Cadastre-se e depois Salvar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите «Изменить текст», введите новые слова, например «Регистрация», и нажмите «Сохранить»."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj Redigera text, skriv nya ord som Registrera dig och tryck sedan på Spara."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Chagua Hariri maandishi, andika maneno mapya kama Jisajili, kisha Hifadhi."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกแก้ไขข้อความ พิมพ์คำใหม่ เช่น สมัครสมาชิก แล้วเลือกบันทึก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Metni düzenle’yi seç, Kaydol gibi yeni sözcükler yaz, sonra Kaydet’i seç."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть «Змінити текст», введіть нові слова, як-от «Реєстрація», і натисніть «Зберегти»."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "«متن میں ترمیم کریں» منتخب کریں، «سائن اپ» جیسے نئے الفاظ لکھیں، پھر «محفوظ کریں» منتخب کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn Sửa văn bản, nhập từ mới như Đăng ký, rồi chọn Lưu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择“编辑文字”，输入“注册”之类的新文字，然后选择“保存”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇「編輯文字」，輸入「註冊」之類的新文字，然後選擇「儲存」。"
          }
        }
      }
    },
